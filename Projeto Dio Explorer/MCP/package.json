{
  "name": "dio-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server for DIO Explorer — exposes /trilha, /desafio and /certificado commands via MCP protocol (stdio + HTTP)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch build/index.js",
    "start:stdio": "node build/index.js",
    "start:http": "node build/index.js --transport http",
    "setup-key": "node build/setup-api-key.js"
  },
  "bin": {
    "dio-explorer-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
