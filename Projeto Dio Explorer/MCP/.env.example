# DIO Explorer MCP Server — Environment Variables
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env — ele está no .gitignore

# ─── Autenticação estática (API Key) ────────────────────────────────────────
# Gere com: node build/setup-api-key.js
DIO_API_KEY=

# ─── Autenticação HTTPS / JWT ────────────────────────────────────────────────
# Segredo mínimo de 32 caracteres para assinar tokens internos
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIO_JWT_SECRET=

# TTL dos tokens JWT em segundos (padrão: 3600 = 1 hora)
DIO_TOKEN_TTL_SECONDS=3600

# ─── Servidor HTTP ───────────────────────────────────────────────────────────
# Porta do servidor HTTP (sem TLS)
DIO_PORT=3000

# ─── Servidor HTTPS (TLS) ────────────────────────────────────────────────────
# Forneça caminhos absolutos ou relativos ao diretório MCP/
# Deixe em branco para operar em HTTP puro (modo dev)
DIO_TLS_CERT=
DIO_TLS_KEY=
# CA intermediária (opcional, para cadeia completa)
DIO_TLS_CA=

# Porta HTTPS quando TLS estiver configurado (padrão: 3443)
# DIO_PORT=3443

# Sobe um servidor HTTP extra que redireciona para HTTPS
DIO_REDIRECT_HTTP=false
DIO_HTTP_PORT=3000

# ─── SSO / OAuth 2.0 ─────────────────────────────────────────────────────────
# URL base do provider OAuth (ex: Google, Keycloak, Okta, Azure AD)
# Deixe em branco para usar modo demo local (tokens gerados sem provider externo)
DIO_OAUTH_PROVIDER=

# Credenciais registradas no provider
DIO_OAUTH_CLIENT_ID=
DIO_OAUTH_CLIENT_SECRET=

# Callback URL registrada no provider
# Deve corresponder exatamente ao registrado no provider
DIO_OAUTH_REDIRECT_URI=https://seu-servidor.com/oauth/callback

# Escopos solicitados (separados por espaço)
DIO_OAUTH_SCOPES=openid profile email

# ─── Desenvolvimento ─────────────────────────────────────────────────────────
# true → desativa toda autenticação (NUNCA use em produção)
# DIO_AUTH_DISABLED=true
